---
import type { FaqItem } from '../data/faq';

type Props = {
  items: FaqItem[];
  title?: string;
};

const { items, title = 'Common questions' } = Astro.props;
const visible = items.filter((item) => item.published && item.answer);
---

{
  visible.length > 0 && (
    <section class="faq section">
      <div class="container faq__inner">
        <div>
          <p class="eyebrow">FAQ</p>
          <h2>{title}</h2>
        </div>
        <div class="faq__list">
          {visible.map((item) => (
            <details class="faq__item">
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .faq__inner {
    display: grid;
    gap: var(--space-6);
  }

  .faq__list {
    display: grid;
    gap: 0.75rem;
  }

  .faq__item {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem 1.15rem;
  }

  .faq__item summary {
    cursor: pointer;
    font-weight: 650;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item p {
    margin-top: 0.75rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 900px) {
    .faq__inner {
      grid-template-columns: 0.8fr 1.2fr;
      align-items: start;
    }
  }
</style>
