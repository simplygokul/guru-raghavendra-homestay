---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import EnquiryCTA from '../components/EnquiryCTA.astro';
import FAQ from '../components/FAQ.astro';
import { accommodationUnits } from '../data/accommodation';
import { availableAmenities } from '../data/amenities';
import { publishedFaqs } from '../data/faq';
import { policies, stayEnquiryMessage, whatsappLink } from '../data/property';
import { pageSeo } from '../data/seo';
import { breadcrumbSchema, faqPageSchema, webPageSchema } from '../lib/schema';

import livingImage from '../assets/rooms/spacious-common-living-area.jpg';
import bedroomImage from '../assets/rooms/spacious-bedroom-carved-wood-bed.jpg';
import bathroomImage from '../assets/rooms/clean-attached-bathroom.jpg';
import terraceImage from '../assets/terrace/terrace-overlooking-agricultural-fields.jpg';
import bedroomAlt from '../assets/rooms/bedroom-built-in-shelving.jpg';

const seo = pageSeo.stay;
const unit = accommodationUnits[0];
const waHref = whatsappLink(stayEnquiryMessage(unit.name));

const faqSchema = faqPageSchema(
  publishedFaqs.map((f) => ({ question: f.question, answer: f.answer! })),
);

const jsonLd = [
  webPageSchema({
    name: seo.title,
    description: seo.description,
    url: 'https://gururaghavendrahomestay.in/stay/',
  }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Stay', path: '/stay/' },
  ]),
  faqSchema,
].filter(Boolean);
---

<BaseLayout title={seo.title} description={seo.description} path={seo.path} ogImage={seo.ogImage} jsonLd={jsonLd}>
  <section class="stay-open section">
    <div class="container stay-open__grid">
      <div>
        <p class="eyebrow">Stay</p>
        <h1>{seo.h1}</h1>
        <p class="lede">{unit.summary}</p>
        <div class="btn-row">
          <a
            class="btn btn--wa"
            href={waHref}
            data-analytics="stay_enquiry_click"
            data-location="stay-hero"
            target="_blank"
            rel="noopener noreferrer"
          >
            Ask About This Stay
          </a>
          <a class="btn btn--secondary" href="/gallery/">See Gallery</a>
        </div>
      </div>
    </div>
    <div class="container stay-open__hero reveal">
      <Image
        src={livingImage}
        alt="Spacious common living area for families and groups"
        widths={[900, 1400, 1800]}
        sizes="100vw"
        quality={82}
        class="stay-open__img"
      />
    </div>
  </section>

  <section class="section journey">
    <div class="container container--narrow">
      <div class="journey__copy reveal">
        <p class="eyebrow">Common areas</p>
        <h2>Space where the whole group can gather</h2>
        <p class="lede">Open living areas with room to move — not cramped lodge rooms.</p>
      </div>
      <figure class="reveal">
        <Image src={bedroomAlt} alt="Bright bedroom with built-in shelving" widths={[700, 1100]} sizes="(max-width: 900px) 100vw, 50vw" quality={80} />
      </figure>
    </div>
  </section>

  <section class="section section--muted journey">
    <div class="container journey__block journey__block--flip">
      <figure class="reveal">
        <Image src={bedroomImage} alt="Bedroom with carved wooden bed" widths={[700, 1100]} sizes="(max-width: 900px) 100vw, 50vw" quality={80} />
      </figure>
      <div class="journey__copy reveal">
        <p class="eyebrow">Bedrooms</p>
        <h2>Comfortable rooms for restful nights</h2>
        <p class="lede">Clean finishes, good light and space to unpack after temple visits.</p>
      </div>
    </div>
  </section>

  <section class="section journey">
    <div class="container journey__block">
      <div class="journey__copy reveal">
        <p class="eyebrow">Kitchen</p>
        <h2>Cook when it helps your day</h2>
        <p class="lede">
          Kitchen access makes longer family stays easier — especially with children or elders who prefer familiar meals.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--muted journey">
    <div class="container journey__block journey__block--flip">
      <figure class="reveal">
        <Image src={bathroomImage} alt="Clean attached bathroom" widths={[700, 1100]} sizes="(max-width: 900px) 100vw, 50vw" quality={80} />
      </figure>
      <div class="journey__copy reveal">
        <p class="eyebrow">Bathrooms</p>
        <h2>Clear, bright and well kept</h2>
        <p class="lede">Simple, modern bathrooms that look the way they feel.</p>
      </div>
    </div>
  </section>

  <section class="section journey">
    <div class="container journey__block">
      <div class="journey__copy reveal">
        <p class="eyebrow">Terrace</p>
        <h2>Open air and countryside views</h2>
        <p class="lede">Step up for fields, breeze and a quieter end to the day.</p>
      </div>
      <figure class="reveal">
        <Image src={terraceImage} alt="Terrace overlooking agricultural fields" widths={[700, 1100]} sizes="(max-width: 900px) 100vw, 50vw" quality={80} />
      </figure>
    </div>
  </section>

  <section class="section section--muted amenities">
    <div class="container amenities__inner">
      <div>
        <p class="eyebrow">Facilities</p>
        <h2>What you can count on</h2>
      </div>
      <ul class="amenity-list">
        {availableAmenities.map((a) => <li>{a.label}</li>)}
      </ul>
    </div>
  </section>

  <section class="section arrival">
    <div class="container container--narrow">
      <p class="eyebrow">Arrival</p>
      <h2>Flexible check-in for temple visitors</h2>
      <p class="lede">{policies.flexibleCheckIn}</p>
      <a
        class="btn btn--primary"
        href={waHref}
        data-analytics="stay_enquiry_click"
        data-location="stay-checkin"
        target="_blank"
        rel="noopener noreferrer"
      >
        Confirm Availability on WhatsApp
      </a>
    </div>
  </section>

  <FAQ items={publishedFaqs} title="Booking & stay questions" />
  <EnquiryCTA title="Ready to check dates?" text="Share your dates and guest count on WhatsApp — we will guide you from there." />
</BaseLayout>

<style>
  .stay-open {
    padding-bottom: 0;
  }

  .stay-open__grid {
    max-width: 40rem;
    margin-bottom: 2rem;
  }

  .stay-open__img {
    width: 100%;
    border-radius: var(--radius-lg);
  }

  .journey__block {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .journey figure img {
    width: 100%;
    border-radius: var(--radius-lg);
  }

  .journey__copy {
    max-width: 32rem;
  }

  .amenities__inner {
    display: grid;
    gap: var(--space-5);
  }

  .amenity-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }

  .amenity-list li {
    padding-left: 1rem;
    position: relative;
    color: var(--color-text-muted);
  }

  .amenity-list li::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-green);
    position: absolute;
    left: 0;
    top: 0.55rem;
  }

  .arrival {
    text-align: left;
  }

  @media (min-width: 900px) {
    .journey__block {
      grid-template-columns: 1fr 1.1fr;
      gap: var(--space-8);
    }

    .journey__block--flip {
      grid-template-columns: 1.1fr 1fr;
    }

    .amenities__inner {
      grid-template-columns: 0.8fr 1.2fr;
      align-items: start;
    }
  }
</style>
