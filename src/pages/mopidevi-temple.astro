---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import EnquiryCTA from '../components/EnquiryCTA.astro';
import { pageSeo } from '../data/seo';
import { breadcrumbSchema, webPageSchema } from '../lib/schema';

import templeCue from '../assets/places/mopidevi-local-context.jpg';

const seo = pageSeo.temple;

const sections = [
  { id: 'overview', label: 'Overview' },
  { id: 'visit', label: 'Planning your visit' },
  { id: 'reach', label: 'Getting to Mopidevi' },
  { id: 'stay', label: 'Staying nearby' },
];

const jsonLd = [
  webPageSchema({
    name: seo.title,
    description: seo.description,
    url: 'https://gururaghavendrahomestay.in/mopidevi-temple/',
  }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Mopidevi Temple Guide', path: '/mopidevi-temple/' },
  ]),
];
---

<BaseLayout title={seo.title} description={seo.description} path={seo.path} ogImage={seo.ogImage} jsonLd={jsonLd}>
  <header class="guide-hero section">
    <div class="container guide-hero__grid">
      <div>
        <p class="eyebrow">Temple guide</p>
        <h1>{seo.h1}</h1>
        <p class="lede">
          A calm, practical introduction to Sri Subrahmanyeswara Swamy Temple for families visiting Mopidevi.
        </p>
      </div>
      <figure>
        <Image
          src={templeCue}
          alt="Mopidevi local setting near the temple town"
          widths={[700, 1100]}
          sizes="(max-width: 900px) 100vw, 48vw"
          quality={80}
        />
      </figure>
    </div>
  </header>

  <nav class="toc" aria-label="On this page">
    <div class="container toc__inner">
      {sections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
    </div>
  </nav>

  <article class="guide">
    <section class="section section--tight" id="overview">
      <div class="container container--narrow prose">
        <h2>Overview</h2>
        <p>
          Mopidevi is known for Sri Subrahmanyeswara Swamy Temple, an important spiritual destination in
          Krishna District, Andhra Pradesh. Many families combine darshan with an overnight stay so elders
          and children can rest between visits.
        </p>
        <p>
          The temple sits within a quieter town setting — less rushed than a large city pilgrimage stop —
          which makes a nearby homestay especially useful.
        </p>
      </div>
    </section>

    <section class="section section--tight section--muted" id="visit">
      <div class="container container--narrow prose">
        <h2>Planning your visit</h2>
        <p>
          Arrive with enough time for rest, especially if travelling with seniors or young children. Keep
          water handy, dress respectfully for the temple, and allow buffer time around peak hours.
        </p>
        <ul>
          <li>Plan rest between travel and darshan.</li>
          <li>Ask locals about current crowd patterns on festival days.</li>
          <li>Keep valuables minimal in busy periods.</li>
        </ul>
        <p>
          For nearby places beyond the temple, see our
          <a href="/places-to-visit-near-mopidevi/">places to visit near Mopidevi</a> guide.
        </p>
      </div>
    </section>

    <section class="mid-cta section--tight">
      <div class="container mid-cta__inner">
        <div>
          <h2>Stay close after darshan</h2>
          <p>
            Sri Guru Raghavendra HomeStay offers spacious rooms, kitchen access and a peaceful terrace —
            a practical base for temple visitors and family trips.
          </p>
        </div>
        <a class="btn btn--primary" href="/stay/">View Stay</a>
      </div>
    </section>

    <section class="section section--tight" id="reach">
      <div class="container container--narrow prose">
        <h2>Getting to Mopidevi</h2>
        <p>
          Mopidevi is in Krishna District and is commonly reached by road from nearby towns and cities in
          coastal Andhra Pradesh. Road conditions and travel time vary by season and starting point — check
          your preferred maps app for the latest route before you travel.
        </p>
      </div>
    </section>

    <section class="section section--tight section--muted" id="stay">
      <div class="container container--narrow prose">
        <h2>Staying nearby</h2>
        <p>
          A short stay nearby helps families keep the day unhurried. Message us with your dates and guest
          count — early or flexible check-in may be available for temple visitors subject to prior
          confirmation.
        </p>
      </div>
    </section>
  </article>

  <EnquiryCTA
    title="Need a calm place after darshan?"
    text="Share your travel dates on WhatsApp and we will help you plan a comfortable stay in Mopidevi."
  />
</BaseLayout>

<style>
  .guide-hero__grid {
    display: grid;
    gap: var(--space-6);
    align-items: end;
  }

  .guide-hero figure img {
    width: 100%;
    border-radius: var(--radius-lg);
  }

  .toc {
    border-block: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
    position: sticky;
    top: var(--header-h);
    z-index: 20;
  }

  .toc__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    padding-block: 0.85rem;
  }

  .toc a {
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .toc a:hover {
    color: var(--color-green);
  }

  .prose h2 {
    margin-top: 0.5rem;
  }

  .prose p,
  .prose li {
    color: var(--color-text-muted);
    font-size: 1.08rem;
  }

  .mid-cta {
    padding-inline: var(--gutter);
  }

  .mid-cta__inner {
    width: min(100%, var(--container));
    margin-inline: auto;
    display: grid;
    gap: 1.25rem;
    align-items: center;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.6rem;
  }

  .mid-cta p {
    color: var(--color-text-muted);
    margin: 0;
  }

  @media (min-width: 860px) {
    .guide-hero__grid {
      grid-template-columns: 1.05fr 0.95fr;
    }

    .mid-cta__inner {
      grid-template-columns: 1fr auto;
    }
  }
</style>
