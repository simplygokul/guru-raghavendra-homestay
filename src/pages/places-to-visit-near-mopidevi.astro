---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import EnquiryCTA from '../components/EnquiryCTA.astro';
import { publishedDestinations, featuredDestination } from '../data/destinations';
import { pageSeo } from '../data/seo';
import { breadcrumbSchema, webPageSchema } from '../lib/schema';

import mopideviImage from '../assets/places/mopidevi-area.jpg';
import kallepalliImage from '../assets/places/kallepalli.jpg';
import terraceImage from '../assets/terrace/countryside-panorama.jpg';
import fields from '../assets/terrace/terrace-overlooking-agricultural-fields.jpg';

const seo = pageSeo.explore;
const supporting = publishedDestinations.filter((d) => d.id !== featuredDestination?.id);

const jsonLd = [
  webPageSchema({
    name: seo.title,
    description: seo.description,
    url: 'https://gururaghavendrahomestay.in/places-to-visit-near-mopidevi/',
  }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Places to Visit', path: '/places-to-visit-near-mopidevi/' },
  ]),
];
---

<BaseLayout title={seo.title} description={seo.description} path={seo.path} ogImage={seo.ogImage} jsonLd={jsonLd}>
  <section class="explore-open">
    <div class="explore-open__media">
      <Image
        src={fields}
        alt="Countryside views near Mopidevi"
        widths={[900, 1400, 2000]}
        sizes="100vw"
        quality={82}
        class="explore-open__img"
      />
      <div class="explore-open__shade"></div>
    </div>
    <div class="container explore-open__content">
      <p class="eyebrow">Explore</p>
      <h1>{seo.h1}</h1>
      <p>
        Use Mopidevi as a calm base for temple visits, countryside quiet and gentle outings in the region.
      </p>
    </div>
  </section>

  <section class="section feature-dest">
    <div class="container feature-dest__grid">
      <figure class="reveal">
        <Image
          src={mopideviImage}
          alt={featuredDestination.name}
          widths={[800, 1200]}
          sizes="(max-width: 900px) 100vw, 58vw"
          quality={80}
        />
      </figure>
      <div class="reveal">
        <p class="eyebrow">Primary destination</p>
        <h2>{featuredDestination.name}</h2>
        <p class="lede">{featuredDestination.whyVisit}</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/mopidevi-temple/">Temple Guide</a>
          {
            featuredDestination.mapsUrl ? (
              <a
                class="btn btn--secondary"
                href={featuredDestination.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Open in Maps
              </a>
            ) : null
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <div class="support-intro reveal">
        <p class="eyebrow">Nearby</p>
        <h2>Continue the journey</h2>
      </div>
      <div class="support-grid">
        {
          supporting.map((place) => {
            const img = place.id === 'kallepalli' ? kallepalliImage : terraceImage;
            return (
              <article class="support-card reveal">
                <Image src={img} alt={place.name} widths={[500, 900]} sizes="(max-width: 800px) 100vw, 48vw" quality={78} />
                <div>
                  <h3>{place.name}</h3>
                  <p>{place.whyVisit}</p>
                  {place.mapsUrl ? (
                    <a href={place.mapsUrl} target="_blank" rel="noopener noreferrer">
                      Open in Maps
                    </a>
                  ) : null}
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow stay-cue">
      <p class="eyebrow">Stay as your base</p>
      <h2>Return to space and quiet at the end of the day</h2>
      <p class="lede">
        After darshan or a countryside drive, come back to spacious rooms, kitchen convenience and a calm terrace.
      </p>
      <a class="btn btn--primary" href="/stay/">View Stay</a>
    </div>
  </section>

  <EnquiryCTA />
</BaseLayout>

<style>
  .explore-open {
    position: relative;
    min-height: min(62vh, 30rem);
    display: grid;
    align-items: end;
    color: white;
    overflow: clip;
  }

  .explore-open__media {
    position: absolute;
    inset: 0;
  }

  .explore-open__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .explore-open__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(18 22 20 / 0.72), transparent 60%);
  }

  .explore-open__content {
    position: relative;
    z-index: 1;
    padding-block: 4rem 2.75rem;
    max-width: 38rem;
  }

  .explore-open h1 {
    color: white;
  }

  .explore-open p {
    color: rgb(247 246 242 / 0.9);
  }

  .feature-dest__grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .feature-dest figure img,
  .support-card img {
    width: 100%;
    border-radius: var(--radius-lg);
  }

  .support-intro {
    margin-bottom: 1.75rem;
  }

  .support-grid {
    display: grid;
    gap: 1.5rem;
  }

  .support-card {
    display: grid;
    gap: 1rem;
  }

  .support-card h3 {
    margin-bottom: 0.4rem;
  }

  .support-card p {
    color: var(--color-text-muted);
  }

  .stay-cue {
    text-align: left;
  }

  @media (min-width: 860px) {
    .feature-dest__grid {
      grid-template-columns: 1.2fr 0.9fr;
      gap: var(--space-8);
    }

    .support-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }
</style>
