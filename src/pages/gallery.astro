---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import EnquiryCTA from '../components/EnquiryCTA.astro';
import { galleryCategories } from '../data/gallery';
import { pageSeo } from '../data/seo';
import { breadcrumbSchema, webPageSchema } from '../lib/schema';

import exterior from '../assets/property/homestay-exterior-facade-mopidevi.jpg';
import living from '../assets/rooms/spacious-common-living-area.jpg';
import bedroom from '../assets/rooms/spacious-bedroom-carved-wood-bed.jpg';
import bedroom2 from '../assets/rooms/bedroom-built-in-shelving.jpg';
import bathroom from '../assets/rooms/clean-attached-bathroom.jpg';
import common from '../assets/rooms/family-common-living-space.jpg';
import terrace from '../assets/terrace/terrace-overlooking-agricultural-fields.jpg';

const seo = pageSeo.gallery;

const images = [
  { src: exterior, alt: 'Homestay exterior facade in Mopidevi', category: 'exterior', label: 'Exterior' },
  { src: living, alt: 'Spacious common living area', category: 'common', label: 'Common Spaces' },
  { src: bedroom, alt: 'Bedroom with carved wooden bed', category: 'rooms', label: 'Rooms' },
  { src: bedroom2, alt: 'Bedroom with built-in shelving', category: 'rooms', label: 'Rooms' },
  { src: bathroom, alt: 'Clean attached bathroom', category: 'bathrooms', label: 'Bathrooms' },
  { src: common, alt: 'Family common living space', category: 'common', label: 'Common Spaces' },
  { src: terrace, alt: 'Terrace overlooking agricultural fields', category: 'terrace', label: 'Terrace' },
];

const jsonLd = [
  webPageSchema({
    name: seo.title,
    description: seo.description,
    url: 'https://gururaghavendrahomestay.in/gallery/',
  }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Gallery', path: '/gallery/' },
  ]),
];
---

<BaseLayout title={seo.title} description={seo.description} path={seo.path} ogImage={seo.ogImage} jsonLd={jsonLd}>
  <section class="section gallery-page">
    <div class="container">
      <p class="eyebrow">Gallery</p>
      <h1>{seo.h1}</h1>
      <p class="lede">
        Genuine photographs of the rooms, bathrooms, common spaces, terrace and exterior. Kitchen and
        surroundings sets will expand as curation continues.
      </p>

      <div class="filters" role="tablist" aria-label="Gallery categories">
        {
          galleryCategories.map((cat, index) => (
            <button
              type="button"
              class:list={['filter', index === 0 && 'is-active']}
              data-filter={cat.id}
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
            >
              {cat.label}
            </button>
          ))
        }
      </div>

      <div class="grid" data-gallery-grid>
        {
          images.map((image, index) => (
            <button
              type="button"
              class="grid__item"
              data-category={image.category}
              data-gallery-open
              data-index={index}
              aria-label={`Open ${image.alt}`}
            >
              <Image
                src={image.src}
                alt={image.alt}
                widths={[400, 700, 1000]}
                sizes="(max-width: 700px) 100vw, 33vw"
                loading={index < 3 ? 'eager' : 'lazy'}
              />
              <span>{image.label}</span>
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <dialog class="lightbox" data-lightbox aria-label="Image viewer">
    <form method="dialog" class="lightbox__bar">
      <button value="close" class="lightbox__close" aria-label="Close">Close</button>
    </form>
    <img data-lightbox-img alt="" />
    <div class="lightbox__nav">
      <button type="button" data-lightbox-prev>Previous</button>
      <button type="button" data-lightbox-next>Next</button>
    </div>
  </dialog>

  <EnquiryCTA />
</BaseLayout>

<script>
  const filters = document.querySelectorAll('[data-filter]');
  const items = document.querySelectorAll('.grid__item');
  const dialog = document.querySelector('[data-lightbox]');
  const dialogImg = document.querySelector('[data-lightbox-img]');
  const sources = Array.from(items).map((item) => {
    const img = item.querySelector('img');
    return {
      src: img?.currentSrc || img?.src || '',
      alt: img?.alt || '',
      category: item.getAttribute('data-category') || 'all',
      el: item,
    };
  });
  let current = 0;

  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter') || 'all';
      filters.forEach((b) => {
        b.classList.toggle('is-active', b === btn);
        b.setAttribute('aria-selected', b === btn ? 'true' : 'false');
      });
      items.forEach((item) => {
        const cat = item.getAttribute('data-category');
        const show = filter === 'all' || cat === filter;
        item.toggleAttribute('hidden', !show);
      });
    });
  });

  function openAt(index: number) {
    current = index;
    if (!(dialog instanceof HTMLDialogElement) || !(dialogImg instanceof HTMLImageElement)) return;
    const item = sources[current];
    dialogImg.src = item.src;
    dialogImg.alt = item.alt;
    dialog.showModal();
    window.dispatchEvent(
      new CustomEvent('analytics', { detail: { event: 'gallery_open', index: current } }),
    );
  }

  items.forEach((item, index) => {
    item.addEventListener('click', () => openAt(index));
  });

  document.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => {
    const visible = sources
      .map((s, i) => ({ i, hidden: s.el.hasAttribute('hidden') }))
      .filter((x) => !x.hidden);
    if (!visible.length) return;
    const pos = visible.findIndex((v) => v.i === current);
    const next = visible[(pos - 1 + visible.length) % visible.length];
    openAt(next.i);
  });

  document.querySelector('[data-lightbox-next]')?.addEventListener('click', () => {
    const visible = sources
      .map((s, i) => ({ i, hidden: s.el.hasAttribute('hidden') }))
      .filter((x) => !x.hidden);
    if (!visible.length) return;
    const pos = visible.findIndex((v) => v.i === current);
    const next = visible[(pos + 1) % visible.length];
    openAt(next.i);
  });

  // Basic swipe on lightbox image
  let touchX = 0;
  dialogImg?.addEventListener('touchstart', (e) => {
    touchX = e.changedTouches[0]?.clientX ?? 0;
  });
  dialogImg?.addEventListener('touchend', (e) => {
    const dx = (e.changedTouches[0]?.clientX ?? 0) - touchX;
    if (Math.abs(dx) < 40) return;
    document
      .querySelector(dx < 0 ? '[data-lightbox-next]' : '[data-lightbox-prev]')
      ?.dispatchEvent(new Event('click'));
  });
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 1.25rem;
  }

  .filter {
    border: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
    border-radius: 999px;
    padding: 0.45rem 0.9rem;
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 650;
    cursor: pointer;
  }

  .filter.is-active {
    background: var(--color-green);
    border-color: var(--color-green);
    color: white;
  }

  .grid {
    columns: 1;
    gap: 0.85rem;
  }

  .grid__item {
    break-inside: avoid;
    margin: 0 0 0.85rem;
    width: 100%;
    border: 0;
    padding: 0;
    background: transparent;
    position: relative;
    cursor: pointer;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .grid__item img {
    width: 100%;
    display: block;
  }

  .grid__item span {
    position: absolute;
    left: 0.7rem;
    bottom: 0.7rem;
    background: rgb(28 34 30 / 0.72);
    color: white;
    border-radius: 999px;
    padding: 0.3rem 0.65rem;
    font-size: var(--text-xs);
    font-weight: 650;
  }

  .lightbox {
    border: 0;
    padding: 0;
    max-width: min(96vw, 1100px);
    background: #111;
    color: white;
  }

  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.72);
  }

  .lightbox img {
    width: 100%;
    max-height: 80vh;
    object-fit: contain;
    background: #111;
  }

  .lightbox__bar,
  .lightbox__nav {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem;
  }

  .lightbox button {
    font: inherit;
    border: 1px solid rgb(255 255 255 / 0.3);
    background: transparent;
    color: white;
    border-radius: 999px;
    padding: 0.45rem 0.9rem;
    cursor: pointer;
  }

  @media (min-width: 700px) {
    .grid {
      columns: 2;
    }
  }

  @media (min-width: 1000px) {
    .grid {
      columns: 3;
    }
  }
</style>
