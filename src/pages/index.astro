---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import EnquiryCTA from '../components/EnquiryCTA.astro';
import {
  businessName,
  contact,
  defaultWhatsAppMessage,
  experiencePillars,
  location,
  positioning,
  whatsappLink,
} from '../data/property';
import { pageSeo } from '../data/seo';
import { lodgingBusinessSchema, websiteSchema, webPageSchema } from '../lib/schema';

import heroImage from '../assets/property/homestay-exterior-hero-daylight.jpg';
import livingImage from '../assets/rooms/spacious-common-living-area.jpg';
import bedroomImage from '../assets/rooms/spacious-bedroom-carved-wood-bed.jpg';
import bathroomImage from '../assets/rooms/clean-attached-bathroom.jpg';
import terraceImage from '../assets/terrace/terrace-overlooking-agricultural-fields.jpg';
import kitchenCue from '../assets/rooms/kitchen-pass-through.jpg';
import bedroomAlt from '../assets/rooms/bedroom-built-in-shelving.jpg';
import templeCue from '../assets/places/mopidevi-local-context.jpg';
import kallepalli from '../assets/places/kallepalli.jpg';
import fields from '../assets/terrace/countryside-panorama.jpg';
import exterior from '../assets/property/exterior-entrance-approach.jpg';

const seo = pageSeo.home;
const waHref = whatsappLink(defaultWhatsAppMessage);
const jsonLd = [
  lodgingBusinessSchema(),
  websiteSchema(),
  webPageSchema({
    name: seo.title,
    description: seo.description,
    url: 'https://gururaghavendrahomestay.in/',
  }),
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  path={seo.path}
  ogImage={seo.ogImage}
  jsonLd={jsonLd}
>
  <!-- ARRIVAL -->
  <section class="hero">
    <div class="hero__media" aria-hidden="true">
      <Image
        src={heroImage}
        alt=""
        widths={[960, 1280, 1600, 1920, 2400]}
        sizes="100vw"
        quality={85}
        loading="eager"
        fetchpriority="high"
        class="hero__img"
      />
      <div class="hero__shade"></div>
    </div>
    <div class="hero__content">
      <p class="hero__brand">{businessName}</p>
      <h1>{seo.h1}</h1>
      <p class="hero__lede">A calm family base near Mopidevi Temple — with space to settle in.</p>
      <div class="btn-row">
        <a
          class="btn btn--wa"
          href={waHref}
          data-analytics="whatsapp_click"
          data-location="hero"
          target="_blank"
          rel="noopener noreferrer"
        >
          WhatsApp Enquiry
        </a>
        <a
          class="btn btn--secondary"
          href={location.mapsDirectionsUrl}
          data-analytics="directions_click"
          data-location="hero"
          target="_blank"
          rel="noopener noreferrer"
        >
          Get Directions
        </a>
      </div>
    </div>
  </section>

  <!-- Value grouping — not icon strip -->
  <section class="pillars section--tight" aria-label="Why guests stay">
    <div class="container pillars__grid">
      {
        experiencePillars.map((pillar) => (
          <article class="pillar reveal">
            <h2>{pillar.title}</h2>
            <p>{pillar.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- STAY — See the Space -->
  <section class="section space">
    <div class="container">
      <div class="space__intro reveal">
        <p class="eyebrow">Stay</p>
        <h2>Room to settle in — not squeeze in</h2>
        <p class="lede">{positioning.support}</p>
      </div>
      <div class="space__stage reveal">
        <figure class="space__main">
          <Image
            src={livingImage}
            alt="Bright spacious common living area with polished floors"
            widths={[720, 1100, 1600]}
            sizes="(max-width: 900px) 100vw, 68vw"
            quality={82}
          />
        </figure>
        <figure class="space__side">
          <Image
            src={bedroomImage}
            alt="Spacious bedroom with carved wooden bed"
            widths={[400, 700, 1000]}
            sizes="(max-width: 900px) 100vw, 28vw"
            quality={82}
          />
        </figure>
      </div>
      <div class="space__actions reveal">
        <a class="btn btn--primary" href="/stay/" data-analytics="stay_enquiry_click" data-location="see-space">
          Explore the Stay
        </a>
      </div>
    </div>
  </section>

  <!-- Family + kitchen woven together -->
  <section class="section section--muted family">
    <div class="container family__grid">
      <figure class="reveal">
        <Image
          src={kitchenCue}
          alt="Open living space with kitchen pass-through for home-style cooking"
          widths={[600, 1000]}
          sizes="(max-width: 900px) 100vw, 48vw"
          quality={80}
        />
      </figure>
      <div class="reveal">
        <p class="eyebrow">Family stays</p>
        <h2>Space for the group. Kitchen when you need it.</h2>
        <p class="lede">
          Longer temple visits and family trips are easier when everyone has room to breathe — and when
          you can prepare simple meals on your own schedule.
        </p>
        <a
          class="btn btn--primary"
          href={whatsappLink('Hello, I would like to know more about family stays and kitchen access at Sri Guru Raghavendra HomeStay.')}
          data-analytics="whatsapp_click"
          data-location="family-kitchen"
          target="_blank"
          rel="noopener noreferrer"
        >
          Ask on WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- Clean bathrooms — photo first -->
  <section class="section clean">
    <div class="container clean__grid">
      <div class="reveal">
        <p class="eyebrow">Cared for</p>
        <h2>Clean, bright and simple</h2>
        <p class="lede">Bathrooms that feel freshly kept — clear tiling, good light, no fuss.</p>
      </div>
      <figure class="reveal">
        <Image
          src={bathroomImage}
          alt="Clean modern bathroom with tiled walls and shower"
          widths={[600, 1000]}
          sizes="(max-width: 900px) 100vw, 52vw"
          quality={80}
        />
      </figure>
    </div>
  </section>

  <!-- BREATHE — signature terrace -->
  <section class="leisure">
    <div class="leisure__media">
      <Image
        src={terraceImage}
        alt="Rooftop terrace overlooking green agricultural fields around Mopidevi"
        widths={[900, 1400, 2000]}
        sizes="100vw"
        quality={82}
        class="leisure__img"
      />
      <div class="leisure__shade"></div>
    </div>
    <div class="leisure__content reveal">
      <p class="eyebrow">Relax</p>
      <h2>Slow mornings. Open skies. Quiet evenings.</h2>
      <p>The terrace looks out over the fields — a calm pause between temple visits and family time.</p>
    </div>
  </section>

  <!-- VISIT — Temple as editorial chapter -->
  <section class="section temple-chapter">
    <div class="container temple-chapter__grid">
      <figure class="reveal">
        <Image
          src={templeCue}
          alt="Local Mopidevi surroundings near Sri Subrahmanyeswara Swamy Temple"
          widths={[700, 1100]}
          sizes="(max-width: 900px) 100vw, 55vw"
          quality={80}
        />
      </figure>
      <div class="reveal">
        <p class="eyebrow">Visit</p>
        <h2>Mopidevi Temple, close to your stay</h2>
        <p class="lede">
          Sri Subrahmanyeswara Swamy Temple draws families and devotees to this quiet Krishna District
          town. Stay nearby, rest well, and ask us for simple local orientation when you need it.
        </p>
        <a class="btn btn--primary" href="/mopidevi-temple/">Read the Temple Guide</a>
      </div>
    </div>
  </section>

  <!-- EXPLORE -->
  <section class="section section--muted explore-preview">
    <div class="container">
      <div class="explore-preview__intro reveal">
        <p class="eyebrow">Explore</p>
        <h2>A base for more than one stop</h2>
        <p class="lede">Use Mopidevi for darshan, countryside quiet, and gentle outings in the region.</p>
      </div>
      <div class="explore-preview__stage reveal">
        <a class="explore-preview__feature" href="/places-to-visit-near-mopidevi/">
          <Image src={kallepalli} alt="Kallepalli and nearby temple-town surroundings" widths={[700, 1100]} sizes="(max-width: 900px) 100vw, 58vw" />
          <span>
            <strong>Kallepalli & nearby</strong>
            Calm temple-town atmosphere for a relaxed outing
          </span>
        </a>
        <a class="explore-preview__support" href="/places-to-visit-near-mopidevi/">
          <Image src={fields} alt="Agricultural countryside views around Mopidevi" widths={[400, 700]} sizes="(max-width: 900px) 100vw, 38vw" />
          <span>Countryside evenings</span>
        </a>
      </div>
      <div class="reveal" style="margin-top: 1.5rem;">
        <a class="btn btn--secondary" href="/places-to-visit-near-mopidevi/">Places to Visit Near Mopidevi</a>
      </div>
    </div>
  </section>

  <!-- FEEL AT HOME — local hospitality -->
  <section class="section hosts">
    <div class="container hosts__grid">
      <div class="reveal">
        <p class="eyebrow">Local hospitality</p>
        <h2>Guidance from people who know Mopidevi</h2>
        <p class="lede">{positioning.hospitality}</p>
      </div>
      <figure class="reveal">
        <Image
          src={bedroomAlt}
          alt="Comfortable bedroom prepared for a family stay"
          widths={[600, 1000]}
          sizes="(max-width: 900px) 100vw, 45vw"
          quality={80}
        />
      </figure>
    </div>
  </section>

  <!-- Gallery editorial preview -->
  <section class="section section--muted gallery-preview">
    <div class="container">
      <div class="gallery-preview__intro reveal">
        <p class="eyebrow">Gallery</p>
        <h2>See the property before you arrive</h2>
      </div>
      <div class="gallery-preview__mosaic reveal">
        <a href="/gallery/" data-analytics="gallery_open" data-location="home" class="mosaic__large">
          <Image src={livingImage} alt="Common living area" widths={[700, 1100]} sizes="(max-width: 800px) 100vw, 55vw" />
        </a>
        <a href="/gallery/" data-analytics="gallery_open" data-location="home" class="mosaic__tall">
          <Image src={exterior} alt="Homestay entrance approach" widths={[400, 700]} sizes="(max-width: 800px) 50vw, 22vw" />
        </a>
        <a href="/gallery/" data-analytics="gallery_open" data-location="home" class="mosaic__wide">
          <Image src={terraceImage} alt="Terrace countryside view" widths={[500, 800]} sizes="(max-width: 800px) 50vw, 22vw" />
        </a>
      </div>
      <div class="reveal" style="margin-top: 1.25rem;">
        <a class="btn btn--primary" href="/gallery/">Open Full Gallery</a>
      </div>
    </div>
  </section>

  <!-- Location -->
  <section class="section location">
    <div class="container location__grid">
      <div class="reveal">
        <p class="eyebrow">Location</p>
        <h2>Find us in Mopidevi</h2>
        <p class="lede">{location.formattedAddress}</p>
        <div class="btn-row">
          <a
            class="btn btn--primary"
            href={location.mapsDirectionsUrl}
            data-analytics="directions_click"
            data-location="home-map"
            target="_blank"
            rel="noopener noreferrer"
          >
            Get Directions
          </a>
          <a
            class="btn btn--secondary"
            href={waHref}
            data-analytics="whatsapp_click"
            data-location="home-map"
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp {contact.whatsapp.display}
          </a>
        </div>
      </div>
      <div class="location__map reveal">
        <iframe
          title={`Map showing ${businessName}`}
          src={location.mapsEmbedUrl}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <EnquiryCTA />
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: min(88vh, 52rem);
    display: grid;
    align-items: end;
    color: white;
    overflow: clip;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(18 22 20 / 0.72) 0%, rgb(18 22 20 / 0.35) 52%, rgb(18 22 20 / 0.12) 100%),
      linear-gradient(0deg, rgb(18 22 20 / 0.5) 0%, transparent 45%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    width: min(100% - (var(--gutter) * 2), 40rem);
    margin: 0 auto 0 var(--gutter);
    padding-block: clamp(4.5rem, 11vw, 7.5rem) clamp(2.75rem, 6vw, 4.5rem);
  }

  .hero__brand {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.4vw, 1.65rem);
    font-weight: 600;
    margin: 0 0 0.75rem;
  }

  .hero h1 {
    color: white;
    margin-bottom: 0.85rem;
    max-width: 14ch;
  }

  .hero__lede {
    color: rgb(247 246 242 / 0.9);
    font-size: var(--text-lg);
    margin-bottom: 1.35rem;
    max-width: 28rem;
  }

  .hero .btn--secondary {
    background: rgb(255 255 255 / 0.94);
  }

  .pillars {
    background: var(--color-bg-elevated);
    border-bottom: 1px solid var(--color-border);
  }

  .pillars__grid {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    padding-block: clamp(2rem, 5vw, 3rem);
  }

  .pillar h2 {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 0.45rem;
  }

  .pillar p {
    margin: 0;
    color: var(--color-text-muted);
    max-width: 22rem;
  }

  .space__intro {
    max-width: 38rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }

  .space__stage {
    display: grid;
    gap: 0.85rem;
    align-items: end;
  }

  .space__main img,
  .space__side img,
  .family figure img,
  .clean figure img,
  .temple-chapter figure img,
  .hosts figure img {
    width: 100%;
    border-radius: var(--radius-lg);
  }

  .space__actions {
    margin-top: 1.5rem;
  }

  .family__grid,
  .clean__grid,
  .temple-chapter__grid,
  .hosts__grid,
  .location__grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .leisure {
    position: relative;
    min-height: min(72vh, 38rem);
    display: grid;
    align-items: end;
    color: white;
    overflow: clip;
  }

  .leisure__media {
    position: absolute;
    inset: 0;
  }

  .leisure__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .leisure__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(18 22 20 / 0.72) 0%, rgb(18 22 20 / 0.2) 55%, transparent 75%);
  }

  .leisure__content {
    position: relative;
    z-index: 1;
    width: min(100% - (var(--gutter) * 2), 36rem);
    margin-inline: var(--gutter);
    padding-block: 4rem 3.25rem;
  }

  .leisure h2 {
    color: white;
    max-width: 16ch;
  }

  .leisure p {
    color: rgb(247 246 242 / 0.88);
    margin: 0;
    max-width: 30rem;
  }

  .explore-preview__intro {
    margin-bottom: 1.75rem;
  }

  .explore-preview__stage {
    display: grid;
    gap: 0.85rem;
  }

  .explore-preview__feature,
  .explore-preview__support {
    position: relative;
    display: block;
    text-decoration: none;
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  .explore-preview__feature img,
  .explore-preview__support img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform 700ms var(--ease);
  }

  .explore-preview__feature:hover img,
  .explore-preview__support:hover img {
    transform: scale(1.03);
  }

  .explore-preview__feature span,
  .explore-preview__support span {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.1rem 1.15rem;
    color: white;
    background: linear-gradient(transparent, rgb(18 22 20 / 0.75));
    font-size: var(--text-sm);
  }

  .explore-preview__feature strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin-bottom: 0.2rem;
  }

  .gallery-preview__mosaic {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1.4fr 1fr;
    grid-template-rows: auto auto;
  }

  .mosaic__large {
    grid-row: span 2;
  }

  .gallery-preview__mosaic a {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  .gallery-preview__mosaic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  .mosaic__large img {
    aspect-ratio: 3 / 4;
    min-height: 100%;
  }

  .location__map {
    border-radius: var(--radius-lg);
    overflow: hidden;
    min-height: 18rem;
    border: 1px solid var(--color-border);
  }

  .location__map iframe {
    width: 100%;
    min-height: 18rem;
    border: 0;
    display: block;
  }

  @media (min-width: 760px) {
    .pillars__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .space__stage {
      grid-template-columns: 1.55fr 0.85fr;
      gap: 1.1rem;
    }

    .explore-preview__stage {
      grid-template-columns: 1.35fr 0.9fr;
      align-items: stretch;
    }

    .explore-preview__support img {
      height: 100%;
      aspect-ratio: auto;
      min-height: 100%;
    }
  }

  @media (min-width: 960px) {
    .family__grid,
    .temple-chapter__grid,
    .hosts__grid,
    .location__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }

    .clean__grid {
      grid-template-columns: 0.85fr 1.15fr;
      gap: var(--space-8);
    }
  }

  @media (max-width: 700px) {
    .gallery-preview__mosaic {
      grid-template-columns: 1fr 1fr;
    }

    .mosaic__large {
      grid-column: span 2;
      grid-row: auto;
    }

    .mosaic__large img {
      aspect-ratio: 16 / 10;
    }

    .hero h1 {
      max-width: none;
    }
  }
</style>
