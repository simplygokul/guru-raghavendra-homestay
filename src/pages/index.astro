---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import EnquiryCTA from '../components/EnquiryCTA.astro';
import {
  businessName,
  brandLine,
  contact,
  defaultWhatsAppMessage,
  location,
  positioning,
  verifiedStrengths,
  whatsappLink,
} from '../data/property';
import { publishedDestinations } from '../data/destinations';
import { pageSeo } from '../data/seo';
import { lodgingBusinessSchema, websiteSchema, webPageSchema } from '../lib/schema';

import heroImage from '../assets/property/homestay-exterior-hero-daylight.jpg';
import livingImage from '../assets/rooms/spacious-common-living-area.jpg';
import bedroomImage from '../assets/rooms/spacious-bedroom-carved-wood-bed.jpg';
import bathroomImage from '../assets/rooms/clean-attached-bathroom.jpg';
import terraceImage from '../assets/terrace/terrace-overlooking-agricultural-fields.jpg';
import commonAlt from '../assets/rooms/family-common-living-space.jpg';
import bedroomAlt from '../assets/rooms/bedroom-built-in-shelving.jpg';

const seo = pageSeo.home;
const waHref = whatsappLink(defaultWhatsAppMessage);
const jsonLd = [
  lodgingBusinessSchema(),
  websiteSchema(),
  webPageSchema({
    name: seo.title,
    description: seo.description,
    url: 'https://gururaghavendrahomestay.in/',
  }),
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  path={seo.path}
  ogImage={seo.ogImage}
  jsonLd={jsonLd}
>
  <!-- HERO: full-bleed property photo, brand-first -->
  <section class="hero">
    <div class="hero__media" aria-hidden="true">
      <Image
        src={heroImage}
        alt="Sri Guru Raghavendra HomeStay exterior in Mopidevi"
        widths={[960, 1280, 1600, 1920, 2400]}
        sizes="100vw"
        quality={85}
        loading="eager"
        fetchpriority="high"
        class="hero__img"
      />
      <div class="hero__shade"></div>
    </div>
    <div class="container hero__content">
      <p class="hero__brand">{businessName}</p>
      <p class="eyebrow hero__eyebrow">Your peaceful stay in Mopidevi</p>
      <h1>{seo.h1}</h1>
      <p class="hero__lede">
        Comfortable family accommodation with kitchen access, a calm terrace overlooking the fields,
        and friendly local guidance near Mopidevi Temple.
      </p>
      <div class="btn-row">
        <a
          class="btn btn--wa"
          href={waHref}
          data-analytics="whatsapp_click"
          data-location="hero"
          target="_blank"
          rel="noopener noreferrer"
        >
          WhatsApp Enquiry
        </a>
        {
          location.mapsDirectionsUrl ? (
            <a
              class="btn btn--secondary"
              href={location.mapsDirectionsUrl}
              data-analytics="directions_click"
              data-location="hero"
              target="_blank"
              rel="noopener noreferrer"
            >
              Get Directions
            </a>
          ) : (
            <a class="btn btn--secondary" href="/contact/">
              Contact & Location
            </a>
          )
        }
      </div>
    </div>
  </section>

  <!-- Quick strengths -->
  <section class="strengths section--tight" aria-label="Property strengths">
    <div class="container strengths__grid">
      {
        verifiedStrengths.map((item) => (
          <article class="strength reveal">
            <h2 class="strength__title">{item.title}</h2>
            <p>{item.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- See the Space -->
  <section class="section space">
    <div class="container space__grid">
      <div class="reveal">
        <p class="eyebrow">See the space</p>
        <h2>Room to settle in — not squeeze in</h2>
        <p class="lede">
          {positioning.support} Guests come for temple visits, family gatherings and quiet weekends —
          and find a place that feels open, practical and genuinely welcoming.
        </p>
        <a class="btn btn--primary" href="/stay/" data-analytics="stay_enquiry_click" data-location="see-space">
          View Stay Details
        </a>
      </div>
      <div class="space__photos reveal">
        <Image
          src={livingImage}
          alt="Bright spacious common living area with polished floors at Sri Guru Raghavendra HomeStay"
          widths={[480, 800, 1200]}
          sizes="(max-width: 900px) 100vw, 55vw"
          class="space__photo space__photo--main"
        />
        <Image
          src={bedroomImage}
          alt="Spacious bedroom with carved wooden bed and built-in storage"
          widths={[360, 640, 960]}
          sizes="(max-width: 900px) 100vw, 28vw"
          class="space__photo space__photo--side"
        />
      </div>
    </div>
  </section>

  <!-- Kitchen -->
  <section class="section section--muted kitchen">
    <div class="container kitchen__grid">
      <div class="kitchen__visual reveal">
        <Image
          src={commonAlt}
          alt="Open common living space with kitchen pass-through visible at the back"
          widths={[480, 800, 1100]}
          sizes="(max-width: 900px) 100vw, 48vw"
        />
      </div>
      <div class="reveal">
        <p class="eyebrow">Kitchen convenience</p>
        <h2>Cook when you need to. Rest when you want to.</h2>
        <p class="lede">
          A kitchen facility makes longer family stays easier — prepare simple meals, manage children’s
          timings, and keep the day flexible around temple visits.
        </p>
        <p class="note">
          Dedicated kitchen close-up photography and equipment list are pending owner confirmation.
        </p>
        <a
          class="btn btn--primary"
          href={whatsappLink('Hello, I would like to know more about kitchen facilities for our stay at Sri Guru Raghavendra HomeStay.')}
          data-analytics="whatsapp_click"
          data-location="kitchen"
          target="_blank"
          rel="noopener noreferrer"
        >
          Ask About Kitchen Access
        </a>
      </div>
    </div>
  </section>

  <!-- Cleanliness / bathroom -->
  <section class="section clean">
    <div class="container clean__grid">
      <div class="reveal">
        <p class="eyebrow">Clean & practical</p>
        <h2>Bathrooms that look the way they feel — clear and cared for</h2>
        <p class="lede">
          Bright tiling, straightforward fixtures and a well-kept finish. We let the photographs show
          hygiene rather than making unverified sanitisation claims.
        </p>
      </div>
      <div class="clean__frame reveal">
        <Image
          src={bathroomImage}
          alt="Clean modern bathroom with tiled walls, shower and geyser"
          widths={[480, 800, 1100]}
          sizes="(max-width: 900px) 100vw, 48vw"
        />
      </div>
    </div>
  </section>

  <!-- Leisure / terrace -->
  <section class="leisure">
    <div class="leisure__media">
      <Image
        src={terraceImage}
        alt="Rooftop terrace overlooking green agricultural fields around Mopidevi"
        widths={[720, 1200, 1800]}
        sizes="100vw"
        class="leisure__img"
      />
      <div class="leisure__shade"></div>
    </div>
    <div class="container leisure__content reveal">
      <p class="eyebrow">Scenic escape</p>
      <h2>Breathe. Relax. Reconnect.</h2>
      <p>
        Evenings on the terrace, agricultural views and a quieter pace — the property supports weekend
        leisure as much as temple travel.
      </p>
      <ul class="leisure__list">
        <li>Open terrace</li>
        <li>Green countryside views</li>
        <li>Fresh air</li>
        <li>Calm evenings</li>
      </ul>
    </div>
  </section>

  <!-- Temple preview -->
  <section class="section temple-preview">
    <div class="container temple-preview__grid">
      <div class="reveal">
        <p class="eyebrow">Visit</p>
        <h2>Mopidevi Temple — close to your stay</h2>
        <p class="lede">
          Sri Subrahmanyeswara Swamy Temple is the spiritual heart of Mopidevi. Our guide covers the
          traditional story, visitor orientation and practical tips for families — without turning the
          page into an advertisement.
        </p>
        <a class="btn btn--primary" href="/mopidevi-temple/">Read the Temple Guide</a>
      </div>
      <aside class="temple-preview__card reveal">
        <h3>Planning a temple visit?</h3>
        <p>
          {brandLine} Message us with your travel dates and we can help with practical local orientation.
        </p>
        <a
          class="btn btn--wa"
          href={whatsappLink('Hello, we are visiting Mopidevi Temple and would like to enquire about staying at Sri Guru Raghavendra HomeStay.')}
          data-analytics="whatsapp_click"
          data-location="temple-preview"
          target="_blank"
          rel="noopener noreferrer"
        >
          WhatsApp for Temple Stay
        </a>
      </aside>
    </div>
  </section>

  <!-- Nearby preview -->
  <section class="section section--muted nearby">
    <div class="container">
      <div class="nearby__intro reveal">
        <p class="eyebrow">Explore</p>
        <h2>A useful base for more than one stop</h2>
        <p class="lede">
          Beyond the temple, Mopidevi and the surrounding Diviseema region offer calm townscapes and
          countryside routes. Distances and itineraries will be published only after verification.
        </p>
      </div>
      <div class="nearby__grid">
        {
          publishedDestinations.map((place) => (
            <article class="nearby__card reveal">
              <h3>{place.name}</h3>
              <p>{place.whyVisit}</p>
            </article>
          ))
        }
      </div>
      <div class="nearby__action reveal">
        <a class="btn btn--secondary" href="/places-to-visit-near-mopidevi/">
          Places to Visit Near Mopidevi
        </a>
      </div>
    </div>
  </section>

  <!-- Local hospitality -->
  <section class="section hosts">
    <div class="container hosts__grid">
      <div class="reveal">
        <p class="eyebrow">Local hospitality</p>
        <h2>Guidance from people who know Mopidevi</h2>
        <p class="lede">
          {positioning.hospitality} No fake concierge promise — just approachable hosts who can point
          you toward practical routes, nearby places and temple-visit basics.
        </p>
        <ul class="hosts__points">
          <li>Clean & hygienic spaces</li>
          <li>Safe, family-oriented stay</li>
          <li>Local tips when you need them</li>
        </ul>
      </div>
      <div class="hosts__photos reveal">
        <Image
          src={bedroomAlt}
          alt="Comfortable bedroom with built-in shelving and natural light"
          widths={[400, 700, 1000]}
          sizes="(max-width: 900px) 100vw, 40vw"
        />
      </div>
    </div>
  </section>

  <!-- Gallery preview -->
  <section class="section section--muted gallery-preview">
    <div class="container">
      <div class="gallery-preview__intro reveal">
        <p class="eyebrow">Gallery</p>
        <h2>See the property before you arrive</h2>
        <p class="lede">Rooms, common spaces, bathrooms, terrace and exterior — real photographs, not stock.</p>
      </div>
      <div class="gallery-preview__grid">
        <a class="gallery-preview__item reveal" href="/gallery/" data-analytics="gallery_open" data-location="home-preview">
          <Image src={livingImage} alt="Common living area preview" widths={[400, 700]} sizes="(max-width: 700px) 100vw, 33vw" />
          <span>Common spaces</span>
        </a>
        <a class="gallery-preview__item reveal" href="/gallery/" data-analytics="gallery_open" data-location="home-preview">
          <Image src={bedroomImage} alt="Bedroom preview" widths={[400, 700]} sizes="(max-width: 700px) 100vw, 33vw" />
          <span>Rooms</span>
        </a>
        <a class="gallery-preview__item reveal" href="/gallery/" data-analytics="gallery_open" data-location="home-preview">
          <Image src={terraceImage} alt="Terrace preview" widths={[400, 700]} sizes="(max-width: 700px) 100vw, 33vw" />
          <span>Terrace</span>
        </a>
      </div>
      <div class="nearby__action reveal">
        <a class="btn btn--primary" href="/gallery/">Open Full Gallery</a>
      </div>
    </div>
  </section>

  <!-- Location -->
  <section class="section location">
    <div class="container location__grid">
      <div class="reveal">
        <p class="eyebrow">Location</p>
        <h2>Find us in Mopidevi</h2>
        <p class="lede">
          {location.locality}, {location.district}, {location.region}, {location.country}.
        </p>
        <p class="note">
          Exact street address, Google Maps embed and pin coordinates are pending GBP confirmation.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/contact/">Contact & Directions</a>
          <a
            class="btn btn--secondary"
            href={waHref}
            data-analytics="whatsapp_click"
            data-location="location"
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp {contact.whatsapp.display}
          </a>
        </div>
      </div>
      <div class="location__map reveal" aria-label="Map placeholder">
        <p>Google Map embed will appear here once the business pin is verified.</p>
        <a href="/contact/">Go to Contact page</a>
      </div>
    </div>
  </section>

  <EnquiryCTA />
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: min(92vh, 54rem);
    display: grid;
    align-items: end;
    color: white;
    overflow: clip;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(20 26 22 / 0.55) 0%, rgb(20 26 22 / 0.28) 42%, rgb(20 26 22 / 0.1) 100%),
      linear-gradient(0deg, rgb(20 26 22 / 0.35) 0%, transparent 48%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-block: clamp(5rem, 12vw, 8rem) clamp(3rem, 7vw, 5rem);
    max-width: 44rem;
    margin-left: var(--gutter);
    margin-right: auto;
    width: min(100% - var(--gutter), 44rem);
  }

  .hero__brand {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.6vw, 1.85rem);
    font-weight: 600;
    margin: 0 0 0.85rem;
    letter-spacing: -0.02em;
  }

  .hero__eyebrow {
    color: #efb48a;
  }

  .hero h1 {
    color: white;
    margin-bottom: 1rem;
  }

  .hero__lede {
    color: rgb(247 246 242 / 0.88);
    font-size: var(--text-lg);
    max-width: 34rem;
    margin-bottom: 1.5rem;
  }

  .hero .btn--secondary {
    background: rgb(255 255 255 / 0.92);
  }

  .strengths {
    background: var(--color-bg-elevated);
    border-bottom: 1px solid var(--color-border);
  }

  .strengths__grid {
    display: grid;
    gap: 1.25rem;
    padding-block: 1.75rem;
  }

  .strength {
    padding-right: 0.5rem;
  }

  .strength__title {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0 0 0.35rem;
  }

  .strength p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .space__grid,
  .kitchen__grid,
  .clean__grid,
  .hosts__grid,
  .location__grid,
  .temple-preview__grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .space__photos {
    display: grid;
    gap: 0.85rem;
  }

  .space__photo,
  .kitchen__visual img,
  .clean__frame img,
  .hosts__photos img {
    border-radius: var(--radius-lg);
    width: 100%;
    height: auto;
  }

  .note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-style: italic;
  }

  .leisure {
    position: relative;
    min-height: 34rem;
    display: grid;
    align-items: center;
    color: white;
    overflow: clip;
  }

  .leisure__media {
    position: absolute;
    inset: 0;
  }

  .leisure__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .leisure__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(20 26 22 / 0.78), rgb(20 26 22 / 0.25) 70%);
  }

  .leisure__content {
    position: relative;
    z-index: 1;
    padding-block: 4.5rem;
    max-width: 36rem;
  }

  .leisure h2 {
    color: white;
  }

  .leisure__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
  }

  .leisure__list li {
    border: 1px solid rgb(247 246 242 / 0.35);
    border-radius: 999px;
    padding: 0.45rem 0.85rem;
    font-size: var(--text-sm);
  }

  .temple-preview__card {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  .nearby__intro {
    margin-bottom: var(--space-6);
  }

  .nearby__grid {
    display: grid;
    gap: 1rem;
  }

  .nearby__card {
    background: var(--color-bg-elevated);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--color-border);
  }

  .nearby__card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.4rem;
  }

  .nearby__card p,
  .temple-preview__card p {
    color: var(--color-text-muted);
    margin: 0 0 1rem;
  }

  .nearby__action {
    margin-top: var(--space-5);
  }

  .hosts__points {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }

  .hosts__points li {
    padding-left: 1.1rem;
    position: relative;
  }

  .hosts__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55rem;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .gallery-preview__intro {
    margin-bottom: var(--space-5);
  }

  .gallery-preview__grid {
    display: grid;
    gap: 0.85rem;
  }

  .gallery-preview__item {
    position: relative;
    display: block;
    text-decoration: none;
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  .gallery-preview__item img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 700ms var(--ease);
  }

  .gallery-preview__item:hover img {
    transform: scale(1.03);
  }

  .gallery-preview__item span {
    position: absolute;
    left: 0.85rem;
    bottom: 0.85rem;
    background: rgb(28 34 30 / 0.72);
    color: white;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 650;
  }

  .location__map {
    min-height: 16rem;
    border-radius: var(--radius-lg);
    border: 1px dashed var(--color-border);
    background: var(--color-bg-muted);
    display: grid;
    place-content: center;
    text-align: center;
    gap: 0.75rem;
    padding: 1.5rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 760px) {
    .strengths__grid {
      grid-template-columns: repeat(5, 1fr);
    }

    .nearby__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .gallery-preview__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .space__photos {
      grid-template-columns: 1.35fr 0.9fr;
      align-items: end;
    }
  }

  @media (min-width: 960px) {
    .space__grid,
    .kitchen__grid,
    .clean__grid,
    .hosts__grid,
    .location__grid,
    .temple-preview__grid {
      grid-template-columns: 1fr 1.05fr;
      gap: var(--space-8);
    }

    .kitchen__grid,
    .clean__grid {
      grid-template-columns: 1.05fr 1fr;
    }
  }
</style>
